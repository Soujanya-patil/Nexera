# Nexera — Hostinger (LiteSpeed / Apache-compatible). Copied into dist/ by Vite.

# --- Routes ------------------------------------------------------------------------------------
# Every sitemap route has its own HTML file with that route's metadata in <head> (written after the
# build by scripts/seo-pages.mjs): /about -> about.html, /products -> products.html,
# /products/tcl-blueark-x5 -> products/tcl-blueark-x5.html. They are served internally: the URL never
# shows .html and never gets a trailing slash. Anything else that is not a real file falls back to
# index.html, and React Router (BrowserRouter) renders it.
Options -MultiViews
# /products is both products.html and the folder products/ (the product pages): never answer a
# folder name with a redirect to its trailing-slash form.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  # A route's own page (checked before the fallback, so /products is products.html, not the folder).
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
  # The same page for a trailing-slash spelling (/about/, /products/), without a redirect; its
  # canonical names the slash-less URL.
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)/$ $1.html [L]
  # Single-page app fallback. Hashed build files are real files or nothing: a missing one must 404,
  # not return index.html (a stale page asking for an old chunk would otherwise receive HTML instead
  # of JavaScript).
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# --- Video -------------------------------------------------------------------------------------
# Correct type, never compressed (compression breaks byte ranges), and byte ranges advertised so
# browsers can seek.
AddType video/mp4 .mp4
<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI \.mp4$ no-gzip dont-vary
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.mp4$">
    Header set Accept-Ranges bytes
    Header unset Content-Encoding
  </FilesMatch>
</IfModule>

# --- Caching -------------------------------------------------------------------------------------
# Every HTML page (index.html and the per-route pages) must always be revalidated so a new deploy
# shows up immediately — a stale page would ask for hashed files that no longer exist (hashed files
# under /assets/ get a one-year immutable cache from assets/.htaccess).
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
