# Nexera — Hostinger (LiteSpeed / Apache-compatible). Copied into dist/ by Vite.

# --- Routes ------------------------------------------------------------------------------------
# Every sitemap route has its own HTML file with that route's metadata in <head> (written after the
# build by scripts/seo-pages.mjs): / -> index.html, /about -> about.html, /products -> products.html,
# /products/tcl-blueark-x5 -> products/tcl-blueark-x5.html. They are served internally: the URL never
# shows .html and never gets a trailing slash. Only those routes and real files answer 200; any other
# URL gets 404.html with a real 404 status (React renders the NotFound page there, marked noindex).
# Hashed build files under /assets/ are real files or nothing, so a missing one is a plain 404 too.
Options -MultiViews
ErrorDocument 404 /404.html
# /products is both products.html and the folder products/ (the product pages): never answer a
# folder name with a redirect to its trailing-slash form.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # The Our Brands page became the product catalogue (the app also redirects in the browser).
  RewriteRule ^brands/?$ /products [R=301,L]
  RewriteRule ^index\.html$ - [L]
  # A route's own page (so /products is products.html, not the folder). index.html and 404.html are
  # files, not routes: /index and /404 must not answer as pages. Tested on the exact path, not
  # %{REQUEST_FILENAME}: for /about/ or /about/x the server resolves REQUEST_FILENAME to .../about
  # (the rest becomes path info), which would match about.html and rewrite in a loop (500).
  RewriteCond $1 !^(index|404)$
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*[^/])$ $1.html [L]
  # The same page for a trailing-slash spelling (/about/, /products/), without a redirect; its
  # canonical names the slash-less URL.
  RewriteCond $1 !^(index|404)$
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)/$ $1.html [L]
</IfModule>

# --- Video -------------------------------------------------------------------------------------
# Correct type, never compressed (compression breaks byte ranges), and byte ranges advertised so
# browsers can seek.
AddType video/mp4 .mp4
<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI \.mp4$ no-gzip dont-vary
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.mp4$">
    Header set Accept-Ranges bytes
    Header unset Content-Encoding
  </FilesMatch>
</IfModule>

# --- Compression -------------------------------------------------------------------------------
# Text responses are compressed: Brotli where the server has it, gzip (deflate) otherwise. Images,
# fonts (woff2 is already compressed) and video are left alone; MP4s are explicitly excluded above.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain application/javascript text/javascript application/json application/ld+json image/svg+xml application/xml text/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json application/ld+json image/svg+xml application/xml text/xml
</IfModule>

# --- Caching -------------------------------------------------------------------------------------
# Every HTML page (index.html and the per-route pages) must always be revalidated so a new deploy
# shows up immediately — a stale page would ask for hashed files that no longer exist (hashed files
# under /assets/ get a one-year immutable cache from assets/.htaccess).
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Fonts (/fonts/*.woff2) and the favicons change rarely and aren't hashed: 30 days. Matched by name, so
  # hashed images under /assets/ keep their one-year immutable cache (FilesMatch is applied after every
  # directory's .htaccess, so a broad \.png rule here would override assets/.htaccess).
  <FilesMatch "(\.woff2|^favicon[^/]*\.(png|svg|ico)|^apple-touch-icon\.png)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
